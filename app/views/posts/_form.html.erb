<div class="post-form">

<%= form_with model: post do |f| %>
  <div>
    <%= f.label :title, "タイトル*" %>
    <%= f.text_field :title %>
  </div>
  
  <div>
    <%= f.label :start_date, "開始日*" %>
    <%= f.date_field :start_date %>
  </div>

  <div>
    <%= f.label :end_date, "終了日*" %>
    <%= f.date_field :end_date %>
  </div>

  <div class="form-check">
    <%= f.label :all_day do %>
    <%= f.check_box :all_day %>
    <span>終日の場合はチェックを入れます</span>
    <% end %>
  </div>

  <div>
    <%= f.label :body, "スケジュールメモ" %>
    <%= f.text_area :body %>
  </div>

  <%= link_to "キャンセル", posts_path %>
  <%= f.submit "保存" %>
<% end %>